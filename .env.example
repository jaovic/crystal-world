# URL pública do site (sitemap, metadados)
NEXT_PUBLIC_SITE_URL=https://crystalworldturismo.com.br

# Sanity (painel em /studio). Sem PROJECT_ID o site usa data/seed.json.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_REVALIDATE_SECRET=

# Leads -> Google Sheets (URL do Web App do Apps Script em docs/google-apps-script.gs)
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# Leads -> e-mail (resend.com)
RESEND_API_KEY=
LEAD_EMAIL_TO=contato@crystalworldturismo.com.br
LEAD_EMAIL_FROM=Site Crystal World <site@crystalworldturismo.com.br>

# Medição
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
